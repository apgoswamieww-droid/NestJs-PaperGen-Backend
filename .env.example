# Runtime
NODE_ENV=development
PORT=3000

# Global route prefix -> all endpoints are served under this path (e.g. /api/health)
API_PREFIX=api

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:4200

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/papergenerator

# Global throttling on auth endpoints (requests per window)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=10

# Set to true when running behind a reverse proxy (needed for secure cookies)
TRUST_PROXY=false

# JWT signing secrets (min 32 chars, must be different from each other)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_APP_ACCESS_SECRET=replace-with-a-random-48-byte-secret-for-school-users
JWT_ADMIN_ACCESS_SECRET=replace-with-a-random-48-byte-secret-for-platform-admins
JWT_ACCESS_TTL=15m

# Refresh token lifetimes
REFRESH_TTL_HOURS=12
REFRESH_TTL_REMEMBER_DAYS=30

# Refresh cookie (SameSite=lax works for same-site dev/prod; use "none" only with HTTPS)
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

# Account lockout after repeated failed logins
AUTH_LOCKOUT_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# School users must change their password this many days after setting it
PASSWORD_MAX_AGE_DAYS=90

# Mail (Gmail SMTP) — fill in SMTP_USER and SMTP_PASS to start sending real emails.
# For Gmail, SMTP_PASS must be an App Password: https://myaccount.google.com/apppasswords
# While SMTP_USER/SMTP_PASS are empty, emails are logged to the API console instead of sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients; defaults to "Paper Generator <SMTP_USER>"
# MAIL_FROM=Paper Generator <you@gmail.com>

# Public base URL of the web app, used to build links inside emails
APP_URL=http://localhost:4200

# How long a password reset link stays valid
PASSWORD_RESET_TTL_MINUTES=30

# How long a school-admin invitation link stays valid
INVITE_TTL_HOURS=72

# Seed script (npm run seed)
SEED_TENANT_NAME=Demo Public School
SEED_TENANT_SLUG=demo-public-school
SEED_SCHOOL_ADMIN_NAME=Demo School Admin
SEED_SCHOOL_ADMIN_EMAIL=admin@demo.school
SEED_SCHOOL_ADMIN_PASSWORD=change-me
SEED_PLATFORM_ADMIN_NAME=Platform Owner
SEED_PLATFORM_ADMIN_EMAIL=owner@papergen.app
SEED_PLATFORM_ADMIN_PASSWORD=change-me